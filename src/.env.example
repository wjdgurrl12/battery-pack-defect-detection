# ── 아티팩트 ────────────────────────────────────────────────────────────────
# 번들 1개(권장) 또는 폴더. 둘 다 있으면 번들이 우선한다.
BD_ARTIFACT_BUNDLE=/opt/battery/battery_model_20260825_165511_b_option.bundle
# BD_ARTIFACT_DIR=/opt/battery/models/20260825_165511_b_option

# 모델 코드. battery_detector.py 가 여기서 step*.py 를 import 한다.
BD_SRC_DIR=/opt/battery/src

# ── Kafka (필수) ────────────────────────────────────────────────────────────
BD_KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092
BD_TOPIC_RAW=battery.raw
BD_TOPIC_SCORE=battery.score
BD_TOPIC_ALARM=battery.alarm
BD_GROUP_ID=battery-detector

# ── 입력 신호 ───────────────────────────────────────────────────────────────
# BMS 원시 전송 주기 [Hz]. 학습 격자가 5초/행이라 1.0 이면 5행마다 1행을 쓴다.
# 이 값이 틀리면 예외 없이 감도와 오탐률이 전부 달라진다.
BD_SOURCE_HZ=1.0

# ── 점수 종류 ───────────────────────────────────────────────────────────────
# rule  : 룰 기반 연속 점수 (기본. 검출 감도가 가장 높다) -> 임계 11.47
# score : max(z_max, SPE, IF) 통합 점수                   -> 임계 33.72
# 임계값은 번들 안에 둘 다 들어 있어 자동으로 짝이 맞는다.
BD_SCORE_KEY=rule

# ── 발행 빈도 ───────────────────────────────────────────────────────────────
# 점수 토픽을 판정 몇 행마다 낼 것인가. 1=5초마다, 12=1분마다. 알람은 항상 즉시.
BD_SCORE_EVERY=1

# ── 안전장치 ────────────────────────────────────────────────────────────────
# 기동 시 번들의 코드 해시와 src/ 대조. 끄지 말 것 (1=켬)
BD_VERIFY_HASH=1
